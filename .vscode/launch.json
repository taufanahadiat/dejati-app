{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Android: Run and Debug Emulator Window",
      "type": "pwa-chrome",
      "request": "attach",
      "address": "localhost",
      "port": 9222,
      "webRoot": "${workspaceFolder}/dist",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "../src/*": "${workspaceFolder}/src/*"
      },
      "preLaunchTask": "Android: prepare emulator debug"
    },
    {
      "name": "Android: install emulator window only",
      "type": "node-terminal",
      "request": "launch",
      "env": {
        "NODE_OPTIONS": "",
        "VSCODE_INSPECTOR_OPTIONS": ""
      },
      "command": "powershell -ExecutionPolicy Bypass -File \"${workspaceFolder}\\scripts\\vscode-android-run.ps1\" -Target emulator -StartEmulator -NoScrcpy"
    },
    {
      "name": "Android: install hardware device + scrcpy",
      "type": "node-terminal",
      "request": "launch",
      "env": {
        "NODE_OPTIONS": "",
        "VSCODE_INSPECTOR_OPTIONS": ""
      },
      "command": "powershell -ExecutionPolicy Bypass -File \"${workspaceFolder}\\scripts\\vscode-android-run.ps1\" -Target device"
    }
  ]
}
